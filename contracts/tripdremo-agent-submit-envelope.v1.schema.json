{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tripdremo-agent-submit-envelope.v1.schema.json",
  "title": "TripdremoAgentSubmitEnvelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "submission_id": { "type": "string", "format": "uuid" },
    "schema_version": { "const": "trip-plan.v3" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "origin": { "type": "string", "maxLength": 255 },
        "destination": { "type": "string", "maxLength": 255 },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "adults": { "type": "integer", "minimum": 1, "maximum": 12, "default": 2 },
        "children": {
          "type": "array",
          "maxItems": 12,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "age": { "type": "integer", "minimum": 0, "maximum": 17 } },
            "required": ["age"]
          }
        },
        "style": {
          "type": "string",
          "enum": ["relaxed", "balanced", "active", "camper", "luxury"],
          "default": "balanced"
        },
        "budget": {
          "type": "string",
          "enum": ["value", "comfortable", "premium"],
          "default": "comfortable"
        },
        "constraints": { "type": "object", "default": {}, "additionalProperties": true }
      },
      "required": ["prompt", "start_date", "end_date"]
    },
    "plan": { "type": "object" }
  },
  "required": ["submission_id", "schema_version", "request", "plan"]
}
