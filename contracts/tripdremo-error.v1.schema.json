{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tripdremo-error.v1.schema.json",
  "title": "TripdremoError",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "not_authenticated",
            "login_pending",
            "login_expired",
            "quota_exceeded",
            "invalid_request",
            "generation_failed",
            "generation_timeout",
            "backend_ai_disabled",
            "plan_not_found",
            "rate_limited",
            "backend_unreachable",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["code", "message", "retryable"]
    }
  },
  "required": ["error"]
}
